# --- App ---
APP_ENV=development
APP_NAME="Pantane DevTools API"
API_PREFIX=/api

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://pantane-devtools.vercel.app

# --- Database (used from Phase 2 onward: usage stats, saved tools) ---
DATABASE_URL=postgresql://user:password@localhost:5432/pantane_devtools

# --- Rate limiting ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_NETWORK=20/minute
RATE_LIMIT_STRICT=10/minute
